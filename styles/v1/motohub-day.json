    },
    {
      "id": "road_secondary_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["match", ["get", "class"], ["secondary", "tertiary"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          8, 0.6,
          14, 5.4,
          20, 17
        ]
      }
    },

    {
      "id": "road_primary_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "primary"],
        ["!=", ["get", "ramp"], 1]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#a9a49c",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          6, 1,
          8, 2.6,
          14, 10,
          20, 26
        ]
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "primary"],
        ["!=", ["get", "ramp"], 1]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          6, 0.4,
          8, 1.6,
          14, 7,
          20, 21
        ]
      }
    },

    {
      "id": "road_link",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "ramp"], 1],
        ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#7fd9b6",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          11, 1,
          14, 3.4,
          20, 10
        ]
      }
    },

    {
      "id": "road_trunk_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "trunk"],
        ["!=", ["get", "ramp"], 1]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#1f8a68",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          5, 0.8,
          7, 2.4,
          14, 10.5,
          20, 27
        ]
      }
    },
    {
      "id": "road_trunk",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "trunk"],
        ["!=", ["get", "ramp"], 1]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#54cfa2",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          5, 0.3,
          7, 1.4,
          14, 7.2,
          20, 22
        ]
      }
    },

    {
      "id": "road_motorway_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 4,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "motorway"],
        ["!=", ["get", "ramp"], 1]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#17795c",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          4, 0.8,
          7, 2.8,
          14, 11.5,
          20, 30
        ]
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 4,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "motorway"],
        ["!=", ["get", "ramp"], 1]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3fc396",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          4, 0.3,
          7, 1.6,
          14, 8,
          20, 24
        ]
      }
    },

    {
      "id": "building_flat",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "maxzoom": 14,
      "paint": {
        "fill-color": "#dcd8d0",
        "fill-outline-color": "#c4bfb6"
      }
    },
    {
      "id": "building_3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#dcd8d0",
        "fill-extrusion-opacity": 0.85,
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], ["get", "height"], 6],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], ["get", "min_height"], 0]
      }
    },

    {
      "id": "boundary_country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 2],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#9a93a8",
        "line-dasharray": [3, 1.5],
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          4, 0.8,
          10, 1.8,
          20, 3
        ]
      }
    },

    {
      "id": "highway-name-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk", "motorway"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-rotation-alignment": "map",
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          12, 12,
          16, 15
        ]
      },
      "paint": {
        "text-color": "#4a4540",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "highway-name-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["match", ["get", "class"], ["minor"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-rotation-alignment": "map",
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          15, 11,
          18, 13
        ]
      },
      "paint": {
        "text-color": "#6b655e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "highway-shield",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 8,
      "filter": [
        "all",
        ["<=", ["get", "ref_length"], 6],
        [">", ["get", "ref_length"], 0],
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "network"], ["us-highway", "us-interstate", "us-state"], false, true]
      ],
      "layout": {
        "icon-image": ["concat", "road_", ["get", "ref_length"]],
        "icon-rotation-alignment": "viewport",
        "icon-size": 1,
        "icon-allow-overlap": true,
        "symbol-placement": ["step", ["zoom"], "point", 11, "line"],
        "symbol-spacing": 300,
        "text-field": ["to-string", ["get", "ref"]],
        "text-font": ["Noto Sans Bold"],
        "text-rotation-alignment": "viewport",
        "text-size": 10
      },
      "paint": {
        "text-color": "#2b2b2b"
      }
    },

    {
      "id": "water_name_label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 9,
      "filter": ["match", ["geometry-type"], ["Point"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 12,
        "text-max-width": 6
      },
      "paint": {
        "text-color": "#2f6f92",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },

    {
      "id": "place_village_suburb",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 11,
      "filter": ["match", ["get", "class"], ["village", "suburb", "hamlet"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4a4540",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "place_town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          8, 12,
          14, 15
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#332f2b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.8,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "place_city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          5, 13,
          12, 17
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#22201d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "place_country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 3,
      "maxzoom": 9,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          3, 11,
          8, 16
        ],
        "text-transform": "uppercase",
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#55505a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.8
      }
    }
  ]
}
