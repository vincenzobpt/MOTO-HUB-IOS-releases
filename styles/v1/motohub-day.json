{
  "version": 8,
  "name": "MOTO-HUB Day",
  "metadata": {
    "motohub:purpose": "Motorcycle TFT basemap. Road hierarchy is the whole point: motorway and trunk read as saturated green at a glance, primary and secondary as bright ribbons, everything else recedes. Buildings, urban POIs, minor boundaries and detailed land use are deliberately absent - at 480p under a helmet they are noise that competes with the road.",
    "motohub:attribution": "OpenFreeMap © OpenMapTiles Data from OpenStreetMap",
    "motohub:fonts": "Only the three stacks OpenFreeMap actually serves (Noto Sans Regular/Bold/Italic). A stack the glyph server does not have renders as nothing, silently.",
    "motohub:terrain-anchor": "The first id matching MapLibreTerrain.ANCHOR_KEYWORDS must be a road layer, so hillshade lands above water and landcover but below the roads. Today that is tunnel_casing.",
    "motohub:tiles": "The source is inlined and pinned to /planet/latest/ rather than resolved through the TileJSON at /planet. That document names a dated build - /planet/20260816_080001_pt/ - and OpenFreeMap rotates it weekly. MapLibre matches cached and downloaded tiles BY URL, so an offline pack built against a dated path goes silently blank the next time OpenFreeMap rebuilds the planet. /planet/latest/ serves the same bytes with the same ETag and does not move. Inlining also removes a network round trip before the first tile. maxzoom 14 is the source's own limit: the dashboard's closer views are overzoomed from z14, online and offline alike."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "minzoom": 0,
      "maxzoom": 14,
      "tiles": [
        "https://tiles.openfreemap.org/planet/latest/{z}/{x}/{y}.pbf"
      ],
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a>"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f3f2ee"
      }
    },

    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": {
        "fill-antialias": false,
        "fill-color": "#9dc48a",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "landcover_grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "farmland"], true, false],
      "paint": {
        "fill-antialias": false,
        "fill-color": "#d3e2b8",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover_rock_ice",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["rock", "ice"], true, false],
      "paint": {
        "fill-antialias": false,
        "fill-color": "#e4e4e2",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover_wetland_sand",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wetland", "sand"], true, false],
      "paint": {
        "fill-antialias": false,
        "fill-color": "#e8e2cd",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "park_fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-antialias": false,
        "fill-color": "#a9cf9a",
        "fill-opacity": 0.25
      }
    },

    {
      "id": "water_fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "fill-color": "#8fcae8"
      }
    },
    {
      "id": "waterway_line",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 8,
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {
        "line-color": "#8fcae8",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          8, 0.6,
          14, 1.8,
          20, 5
        ]
      }
    },

    {
      "id": "tunnel_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "tunnel"],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"], true, false]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#cfcac2",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          11, 2,
          14, 8,
          20, 22
        ]
      }
    },
    {
      "id": "tunnel_fill",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "all",
        ["==", ["get", "brunnel"], "tunnel"],
        ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor"], true, false]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#f0eee9",
        "line-dasharray": [1.4, 0.7],
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          11, 1.2,
          14, 6,
          20, 18
        ]
      }
    },

    {
      "id": "road_path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["match", ["get", "class"], ["path", "pedestrian"], true, false]
      ],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#c9c2b6",
        "line-dasharray": [1.5, 1.2],
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          15, 0.8,
          20, 3.5
        ]
      }
    },
    {
      "id": "road_service_track",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["match", ["get", "class"], ["service", "track"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#f7f5f1",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          14, 0.8,
          16, 2,
          20, 6
        ]
      }
    },

    {
      "id": "road_minor_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "minor"]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#cdc8c0",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          12, 0.8,
          14, 5,
          20, 20
        ]
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        ["!=", ["get", "brunnel"], "tunnel"],
        ["==", ["get", "class"], "minor"]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate", ["exponential", 1.2], ["zoom"],
          12, 0.4,
          14, 3.2,
          20, 16
        ]
      }
    },

    {
